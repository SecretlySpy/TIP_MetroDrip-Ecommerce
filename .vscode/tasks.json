{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MetroDrip: MySQL + Redis (docker)",
      "type": "shell",
      "command": "docker compose up -d --wait --wait-timeout 120 db redis",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "MetroDrip: Django API (0.0.0.0:8080)",
      "detail": "Binds 0.0.0.0 so the Android emulator can reach it on 10.0.2.2.",
      "type": "shell",
      "dependsOn": "MetroDrip: MySQL + Redis (docker)",
      "windows": {
        "command": ".venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8080"
      },
      "command": ".venv/bin/python manage.py runserver 0.0.0.0:8080",
      "options": { "env": { "PAYMENT_PROVIDER": "simulated" } },
      "isBackground": true,
      "problemMatcher": {
        // runserver emits no diagnostics worth surfacing, so the pattern is a
        // deliberate never-match (`(?!)` fails at every position). The file /
        // line / message groups are still required: VS Code validates the
        // pattern structurally, before it ever tries to match, and rejects one
        // without them ("It must have at least have a file and a message").
        // A rejected matcher is dropped, which also drops the background
        // begins/ends signalling that "Wait for Django API" depends on.
        "owner": "metrodrip-runserver",
        "pattern": [{ "regexp": "^(?!)$", "file": 1, "line": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          // Autoreload prints "Watching for file changes" first; a reload that
          // skips it still prints the system-check line. Startup ends with the
          // banner. Verified against real output on 2026-08-24 under a pty —
          // when stdout is piped instead, the child block-buffers the banner
          // and none of it appears until exit, which is a capture artifact and
          // not what VS Code's terminal sees.
          "beginsPattern": "Watching for file changes|Performing system checks",
          "endsPattern": "Starting development server at|Quit the server with"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MetroDrip: Wait for Django API",
      "detail": "Polls the database-backed readiness endpoint before the mobile build starts.",
      "type": "shell",
      "windows": {
        "command": ".venv\\Scripts\\python.exe scripts\\wait-for-http.py http://127.0.0.1:8080/healthz/ready/ --timeout 90"
      },
      "command": ".venv/bin/python scripts/wait-for-http.py http://127.0.0.1:8080/healthz/ready/ --timeout 90",
      "dependsOn": "MetroDrip: Django API (0.0.0.0:8080)",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "MetroDrip: Start and verify Android emulator",
      "detail": "Starts only MetroDrip_Pixel_API36 on emulator-5554 and waits for Android to finish booting.",
      "type": "shell",
      "windows": {
        "command": ".venv\\Scripts\\python.exe scripts\\launch-android-emulator.py --avd MetroDrip_Pixel_API36 --port 5554 --timeout 240"
      },
      "command": ".venv/bin/python scripts/launch-android-emulator.py --avd MetroDrip_Pixel_API36 --port 5554 --timeout 240",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MetroDrip: Expo on Android",
      "detail": "Starts Metro and installs the app only on the verified MetroDrip emulator.",
      "type": "shell",
      "command": "npm run android -- --device MetroDrip_Pixel_API36",
      "options": {
        "cwd": "${workspaceFolder}/mobile",
        "env": { "ANDROID_SERIAL": "emulator-5554" }
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "MetroDrip: Wait for Django API",
        "MetroDrip: Start and verify Android emulator"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MetroDrip: Full mobile stack",
      "detail": "One click: healthy data services, ready API, named emulator, and the app.",
      "dependsOn": ["MetroDrip: Expo on Android"],
      "problemMatcher": []
    },
    {
      "label": "MetroDrip: Backend QA",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\ruff.exe check . ; .venv\\Scripts\\python.exe -m pytest -q" },
      "command": ".venv/bin/ruff check . && .venv/bin/python -m pytest -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MetroDrip: Mobile typecheck",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "group": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
