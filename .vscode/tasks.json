{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MetroDrip: MySQL + Redis (docker)",
      "type": "shell",
      "command": "docker compose up -d db redis",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "MetroDrip: Django API (0.0.0.0:8080)",
      "detail": "Binds 0.0.0.0 so the Android emulator can reach it on 10.0.2.2.",
      "type": "shell",
      "dependsOn": "MetroDrip: MySQL + Redis (docker)",
      "windows": {
        "command": ".venv\\Scripts\\python.exe manage.py runserver 0.0.0.0:8080"
      },
      "command": ".venv/bin/python manage.py runserver 0.0.0.0:8080",
      "options": { "env": { "PAYMENT_PROVIDER": "simulated" } },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Performing system checks",
          "endsPattern": "Quit the server with"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MetroDrip: Start Android emulator",
      "detail": "Boots the MetroDrip_Pixel_API35 AVD created by scripts/setup-android-emulator.ps1.",
      "type": "shell",
      "windows": {
        "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd MetroDrip_Pixel_API35 -netdelay none -netspeed full"
      },
      "command": "$ANDROID_HOME/emulator/emulator -avd MetroDrip_Pixel_API35 -netdelay none -netspeed full",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MetroDrip: Expo on Android",
      "detail": "Starts Metro and installs the app on the running emulator.",
      "type": "shell",
      "command": "npm run android",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "dependsOn": ["MetroDrip: Django API (0.0.0.0:8080)"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "MetroDrip: Full mobile stack",
      "detail": "One click: database, API, emulator, and the app.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "MetroDrip: MySQL + Redis (docker)",
        "MetroDrip: Start Android emulator",
        "MetroDrip: Expo on Android"
      ],
      "problemMatcher": []
    },
    {
      "label": "MetroDrip: Backend QA",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\ruff.exe check . ; .venv\\Scripts\\python.exe -m pytest -q" },
      "command": ".venv/bin/ruff check . && .venv/bin/python -m pytest -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "MetroDrip: Mobile typecheck",
      "type": "shell",
      "command": "npx tsc --noEmit",
      "options": { "cwd": "${workspaceFolder}/mobile" },
      "group": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
