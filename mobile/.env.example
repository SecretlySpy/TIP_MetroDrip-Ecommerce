# Copy to .env. EXPO_PUBLIC_* values are inlined into the app bundle at build
# time, so never put a secret here — the app holds no API credentials by design.

# Android emulator alias for the host machine:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/mobile/v1

# iOS simulator: http://localhost:8080/api/mobile/v1
# Physical device: http://<your-lan-ip>:8080/api/mobile/v1
