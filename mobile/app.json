{
  "expo": {
    "name": "MetroDrip",
    "slug": "metrodrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "metrodrip",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "splash": {
      "backgroundColor": "#141414"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.metrodrip.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock MetroDrip with Face ID."
      }
    },
    "android": {
      "package": "ph.metrodrip.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#141414"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "metrodrip"
  }
}
