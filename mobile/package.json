{
  "name": "metrodrip-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "dependencies:check": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "prebuild:android": "expo prebuild --clean --platform android --no-install",
    "prebuild:ios": "expo prebuild --clean --platform ios --no-install",
    "build:ios": "eas build -p ios --profile preview",
    "build:android": "eas build -p android --profile preview",
    "build:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "~57.0.18",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.19.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": []
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
