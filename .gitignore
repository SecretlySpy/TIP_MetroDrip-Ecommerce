# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Django
staticfiles/
media/
db.sqlite3
backups/

# Secrets — never commit environment files. Named examples remain versioned so
# operators know every required variable without seeing a real credential.
.env
.env.*
deploy/.env.staging
!*.example
!deploy/*.example

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime output
*.log

# Editors / OS
# Editor state is personal, but the shared run configuration is not: the
# Antigravity/VS Code tasks are how a teammate boots the mobile stack.
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
Thumbs.db
.DS_Store
